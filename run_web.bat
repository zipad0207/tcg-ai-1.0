echo 正在启动 Web 服务: http://127.0.0.1:8000 ...
echo [提示] 启动成功后，请在浏览器打开: http://127.0.0.1:8000
echo [提示] 按 Ctrl + C 可退出服务
echo ========================================================
py -m uvicorn web_app.main:app --host 127.0.0.1 --port 8000 --reload
pause
