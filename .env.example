# TCG-AI Project Configuration
# -----------------------------
# Copy this file to .env and fill in your actual keys.

# DeepSeek API Key (for LLM balance, generation, and tuning)
# Obtain from: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Image Generation API Key (SiliconFlow / DashScope)
# SiliconFlow: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY="your-siliconflow-api-key-here"
DASH_SCOPE_API_KEY="your-dashscope-api-key-here"

# Selected Image Generation Model
IMAGE_MODEL="Tongyi-MAI/Z-Image-Turbo"
